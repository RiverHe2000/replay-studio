# Copy to repository .env. Replace both secrets with URL-safe random strings.
# Do not commit the resulting .env.
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-string
MINIO_ROOT_USER=replay-admin
MINIO_ROOT_PASSWORD=replace-with-another-long-random-string
REPLAY_PORT=8080
REPLAY_ASR_MODEL=base
REPLAY_MODEL_DEVICE=cpu
REPLAY_VISUAL_MODEL=openai/clip-vit-base-patch32
# Optional real VLM; leave empty to disable. Requires extra model download/compute.
REPLAY_VLM_MODEL=
REPLAY_REGISTRATION_OPEN=false
REPLAY_SECURE_COOKIES=false
